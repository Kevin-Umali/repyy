<div class="risk-meters">
  <div class="meter-pair" aria-label="Illustrative finding: high severity, medium confidence">
    <div class="risk-meter severity-meter">
      <div class="meter-track" aria-hidden="true">
        <i></i>
        <span class="meter-ticks"></span>
      </div>
      <div>
        <span>Severity</span>
        <strong>High</strong>
        <small>Potential impact</small>
      </div>
    </div>
    <span class="meter-not-equal" aria-hidden="true">
      ≠
    </span>
    <div class="risk-meter confidence-meter">
      <div class="meter-track" aria-hidden="true">
        <i></i>
        <span class="meter-ticks"></span>
      </div>
      <div>
        <span>Confidence</span>
        <strong>Medium</strong>
        <small>Strength of the evidence</small>
      </div>
    </div>
  </div>
</div>
