---
import BaseLayout from "./BaseLayout.astro";
import { getGuide, guides, type Guide } from "../data/guides";
import "../styles/docs.css";

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const currentIndex = guides.findIndex((item) => item.slug === guide.slug);
const previous = currentIndex > 0 ? guides[currentIndex - 1] : undefined;
const next = currentIndex < guides.length - 1 ? guides[currentIndex + 1] : undefined;
const isDocsHome = guide.slug === "docs";
const bodyClass = isDocsHome ? "docs-page docs-home" : "docs-page";
const guideGroups = [
  { label: "Get started", slugs: ["docs", "installation", "cli", "demo"] },
  { label: "Reference", slugs: ["configuration", "isolation", "coverage", "rules", "intelligence", "agent-skill"] },
  { label: "Project", slugs: ["trust", "verification", "security-testing", "changelog", "about"] },
];
---

<BaseLayout title={guide.title} description={guide.description} rootClass="docs-root" {bodyClass}>
  <Fragment slot="header">
    <a class="skip-link" href="#docs-main">
      Skip to {guide.label}
    </a>
    <header class="docs-header">
      <a class="brand" href="/docs/" aria-label="Repyy documentation">
        repyy<span aria-hidden="true">/</span>
        <small>Docs</small>
      </a>
      <div class="docs-search">
        <label for="docs-search">
          <span>Search documentation</span>
          <input id="docs-search" type="search" placeholder="Search documentation" autocomplete="off" />
        </label>
        <p id="docs-search-status" class="visually-hidden" role="status" aria-atomic="true"></p>
      </div>
      <div class="docs-header-links">
        <a href="/">Website</a>
        <a href="https://github.com/Kevin-Umali/repyy">GitHub ↗</a>
      </div>
    </header>
  </Fragment>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <nav aria-label="Documentation guides" tabindex="0">
        {guideGroups.map(({ label, slugs }) => (
          <div class="docs-nav-group">
            <strong>{label}</strong>
            {slugs.map(getGuide).map((item) => (
              <a href={item.route} aria-current={item.slug === guide.slug ? "page" : undefined}>
                {item.slug === "docs" ? "Overview" : item.label}
              </a>
            ))}
          </div>
        ))}
      </nav>
    </aside>
    <main class="docs-main" id="docs-main">
      <div class="docs-compact-nav">
        {!isDocsHome && <a class="docs-guide-link" href="/docs/">All guides</a>}
        <details class="docs-section-menu">
          <summary>On this page</summary>
          <div class="docs-toc-links">
            {guide.sections.map((section) => (
              <a href={`#${section.id}`}>{section.id === "overview" ? "Overview" : section.label}</a>
            ))}
          </div>
        </details>
      </div>
      {!isDocsHome && (
        <p class="docs-breadcrumb">
          <a href="/docs/">Documentation</a>
          <span aria-hidden="true">/</span>
          <span>{guide.label}</span>
        </p>
      )}
      <slot />
      {!isDocsHome && (
        <footer class="docs-footer">
          <p>{previous ? <a href={previous.route}>← {previous.label}</a> : "repyy documentation"}</p>
          {next ? <a href={next.route}>{next.label} →</a> : <a href="/docs/">All documentation →</a>}
        </footer>
      )}
    </main>
    <aside class="docs-toc">
      <nav aria-label="On this page" tabindex="0">
        <strong>On this page</strong>
        <div class="docs-toc-links">
          {guide.sections.map((section) => (
            <a href={`#${section.id}`}>{section.id === "overview" ? "Overview" : section.label}</a>
          ))}
        </div>
      </nav>
    </aside>
  </div>
</BaseLayout>

<script>
  import "../scripts/site.js";
</script>
