---
import BaseLayout from "../layouts/BaseLayout.astro";
import Brand from "../components/Brand.astro";
import StatusLine from "../components/StatusLine.astro";
import TermStage from "../components/TermStage.astro";
import { evidence, faq, formats, installs, limits, matrix, tree } from "../data/landing";
import { release } from "../data/site";
import "../styles/landing.css";

const title = "repyy · scan a repository before you run it";
const description = "A CLI that statically scans an unfamiliar repository before you install dependencies, start it, or open it in your IDE.";

const sections = [
  { id: "top", label: "Overview" },
  { id: "replay", label: "Replay" },
  { id: "surfaces", label: "Surfaces" },
  { id: "formats", label: "Formats" },
  { id: "limits", label: "Limits" },
  { id: "trust", label: "Trust" },
  { id: "help", label: "Help" },
];
const n = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, "0");
const status = (id: string) => `${sections.findIndex((s) => s.id === id) + 1} ${sections.find((s) => s.id === id)?.label}`;

const md = (s: string) =>
  s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/\{([abm]):([^}]*)\}/g, (_, k, t) => `<span class="t-${k}">${t}</span>`);
---

<BaseLayout {title} {description} rootClass="landing-root" bodyClass="landing-page">
  <header class="tabbar" slot="header">
    <a class="skip" href="#main">Skip to content</a>
    <nav aria-label="Primary">
      <Brand href="/" />
      <span class="t-m sep" aria-hidden="true">/</span>
      <ol class="tabs">
        {
          sections.map((s, i) => (
            <li>
              <a href={`#${s.id}`} data-section-link={s.id}>
                <span class="dot" aria-hidden="true">
                  ●
                </span>{" "}
                {i + 1} {s.label}
              </a>
            </li>
          ))
        }
      </ol>
      <div class="ext">
        <a href="/docs/">docs</a>
        <a href="https://github.com/Kevin-Umali/repyy">github ↗</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title" data-section data-status-label={status("top")}>
      <div class="hero-meta">
        <span>repository preflight</span>
        <span>{release.version}</span>
        <span>MIT</span>
        <span>written in Go</span>
        <span class="t-a">static · nothing in the target runs</span>
      </div>
      <pre class="wordmark" aria-hidden="true" data-wordmark></pre>
      <div class="hero-row">
        <div>
          <h1 id="hero-title"><span class="t-a" aria-hidden="true">›</span> Scan the repo before you run it.</h1>
          <p class="lede">
            repyy reads an unfamiliar checkout for install hooks, encoded payloads, credentials and editor tasks, then shows each finding with its source location
            and how much of the repo it covered.
          </p>
        </div>

        <div class="install" data-tabs>
          <div class="install-head">
            <span class="t-m">install with</span>
            <div class="install-tabs" role="tablist" aria-label="Install with">
              {
                installs.map((item, i) => (
                  <button
                    type="button"
                    class="kbtn"
                    role="tab"
                    id={`tab-${item.id}`}
                    aria-selected={i === 0 ? "true" : "false"}
                    aria-controls="install-cmd"
                    data-value={item.command}
                  >
                    {item.id}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="install-cmd" id="install-cmd" role="tabpanel" aria-labelledby="tab-brew">
            <code><span class="t-a">$</span> <span data-output>{installs[0].command}</span></code>
            <button type="button" class="kbtn primary" data-copy aria-label="Copy install command"><kbd class="t-a">i</kbd> <span data-copy-label>copy</span></button>
          </div>
          <p class="then"><span class="t-m">then</span> <code>repyy scan ./take-home --format tui</code></p>
        </div>
      </div>
    </section>

    <div class="replay" data-section id="replay" data-status-label={status("replay")}>
      <TermStage flow="tour" number={n("replay")} caption="A replay of repyy scan with the tui format: the scan runs, three findings appear with a recommended action, and the report is exported as HTML." />
    </div>

    <div class="grid">
      <section class="pane pane-surfaces" id="surfaces" aria-labelledby="surfaces-title" data-section data-status-label={status("surfaces")}>
        <h2 class="pane-label" id="surfaces-title"><span class="t-a">{n("surfaces")}</span> surfaces <span class="t-m">· what it reads</span></h2>
        <p class="pane-lede">The files that run on install, on commit, in CI and in your editor, not just <code>src/</code>.</p>
        <div class="tree" data-tree>
          <p class="tree-head"><b>take-home/</b> <span class="t-m" data-tree-count aria-live="off"></span></p>
          <div class="tree-body">
            <span class="tree-cursor" data-tree-cursor aria-hidden="true"></span>
            <ul>
            {
              tree.map(({ path, note, finding, hitByDefault }) => (
                <li data-row data-hit={hitByDefault ? "" : undefined} data-state="read">
                  <span class="path">{path}</span>
                  <span class="note note-check">
                    <span class="mark" aria-hidden="true">✓</span> {note}
                  </span>
                  <span class="note note-hit">
                    <span class="mark" aria-hidden="true">●</span> {finding}
                  </span>
                </li>
              ))
            }
            </ul>
          </div>
        </div>
      </section>

      <section class="pane pane-model" aria-labelledby="model-title">
        <h2 class="pane-label" id="model-title"><span class="t-a">{n("surfaces")}</span> severity ≠ confidence</h2>
        <p class="pane-lede">Each finding sits on both axes, so a weak signal is never presented as proof.</p>
        <pre class="matrix" aria-describedby="matrix-desc" set:html={matrix} />
        <ul class="legend" id="matrix-desc">
          <li><span class="t-a">●</span> PKG-002 · non-registry source</li>
          <li><b>●</b> PKG-001 · lifecycle script</li>
          <li><b>●</b> REPO-002 · no license</li>
        </ul>
        <p class="pane-foot">Credential-shaped values are redacted in every format. A timeout or read error marks the scan <code class="t-a">SCAN INCOMPLETE</code>.</p>
      </section>

      <section class="pane pane-formats" id="formats" aria-labelledby="formats-title" data-section data-status-label={status("formats")}>
        <h2 class="pane-label" id="formats-title"><span class="t-a">{n("formats")}</span> formats <span class="t-m">· one scan, four outputs</span></h2>
        <div class="formats" data-tabs>
          <div class="format-tabs" role="tablist" aria-label="Report format">
            {
              formats.map((f, i) => (
                <button type="button" class="kbtn" role="tab" id={`fmt-${f.id}`} aria-selected={i === 0 ? "true" : "false"} aria-controls={`panel-${f.id}`}>
                  --format {f.id} <small>{f.use}</small>
                </button>
              ))
            }
          </div>
          {
            formats.map((f, i) => (
              <div class="format-panel" role="tabpanel" id={`panel-${f.id}`} aria-labelledby={`fmt-${f.id}`} hidden={i !== 0}>
                <pre set:html={`<span class="t-a">$</span> ${f.command}\n\n${md(f.preview)}`} />
              </div>
            ))
          }
        </div>
      </section>

      <section class="pane pane-limits" id="limits" aria-labelledby="limits-title" data-section data-status-label={status("limits")}>
        <h2 class="pane-label" id="limits-title"><span class="t-a">{n("limits")}</span> limits <span class="t-m">· every scan has a boundary</span></h2>
        <table class="flags">
          <thead>
            <tr><th scope="col">flag</th><th scope="col">default</th><th scope="col">scope</th></tr>
          </thead>
          <tbody>
            {
              limits.map(([flag, value, scope]) => (
                <tr>
                  <td>
                    <code>{flag}</code>
                  </td>
                  <td>{value}</td>
                  <td>{scope}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="pane-foot">Limits on work, not detection guarantees. <a href="/coverage/">coverage →</a></p>
      </section>

      <section class="pane pane-trust" id="trust" aria-labelledby="trust-title" data-section data-status-label={status("trust")}>
        <h2 class="pane-label" id="trust-title"><span class="t-a">{n("trust")}</span> trust <span class="t-m">· check the tool too</span></h2>
        <ul class="checks">
          {
            evidence.map(([done, name, note, href]) => (
              <li class={done === "x" ? "" : "pending"}>
                <span class="box" aria-hidden="true">
                  [{done}]
                </span>
                {href ? <a href={href}>{name}</a> : <span class="name">{name}</span>}
                <span class="note">{note}</span>
              </li>
            ))
          }
        </ul>
        <p class="pane-foot">Local scans keep source and reports on your machine. <a href="/trust/">trust and limitations →</a></p>
      </section>

      <section class="pane pane-faq" id="help" aria-labelledby="faq-title" data-section data-status-label={status("help")}>
        <h2 class="pane-label" id="faq-title"><span class="t-a">{n("help")}</span> repyy --help <span class="t-m">· before you begin</span></h2>
        <div class="faq">
          {
            faq.map(([q, a]) => (
              <details>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))
          }
        </div>
      </section>
    </div>

    <section class="end" aria-label="Get started">
      <p class="end-line"><span class="t-a">~/take-home ❯</span> repyy scan . --format tui<span class="caret" aria-hidden="true"></span></p>
      <nav class="end-links" aria-label="More">
        <a href="/installation/">install guide</a>
        <a href="/verification/">verify a download</a>
        <a href="/agent-skill/">agent skill</a>
        <a href="/rules/">rule catalog</a>
        <a href="/changelog/">changelog</a>
        <a href="/about/">about</a>
      </nav>
    </section>
  </main>

  <StatusLine
    mode="REVIEW"
    where={status("top")}
    keys={[
      { key: "1–7", label: "jump to a section" },
      { key: "i", label: "copy install" },
      { key: "p", label: "pause replay" },
      { key: "d", label: "docs" },
    ]}
  />
</BaseLayout>

<script>
  import { mountWordmark } from "../scripts/term/ascii-wordmark.js";
  import { mountTreeScan } from "../scripts/term/tree-scan.js";
  import { jumpTo, mountKeys, mountStatus } from "../scripts/term/term-keys.js";

  const wordmark = document.querySelector<HTMLPreElement>("[data-wordmark]");
  if (wordmark) mountWordmark(wordmark);
  const tree = document.querySelector<HTMLElement>("[data-tree]");
  if (tree) mountTreeScan(tree);

  const swap = (el: Element) => {
    el.classList.remove("is-swapping");
    void (el as HTMLElement).offsetWidth;
    el.classList.add("is-swapping");
  };

  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((group) => {
    const tabs = [...group.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const output = group.querySelector<HTMLElement>("[data-output]");
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
        if (panel && !output && panel.hidden === on) {
          panel.hidden = !on;
          if (on) swap(panel);
        }
      });
      if (output && tab.dataset.value) {
        output.textContent = tab.dataset.value;
        swap(output);
        group.querySelector('[role="tabpanel"]')?.setAttribute("aria-labelledby", tab.id);
      }
    };
    tabs.forEach((tab, i) => {
      tab.tabIndex = i === 0 ? 0 : -1;
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length];
        next.focus();
        select(next);
      });
    });
  });

  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy]");
  const copyLabel = copyButton?.querySelector("[data-copy-label]");
  const copyInstall = async () => {
    if (!copyLabel) return;
    const text = document.querySelector("[data-output]")?.textContent ?? "";
    try {
      await navigator.clipboard.writeText(text);
      copyLabel.textContent = "copied ✓";
      swap(copyLabel);
    } catch {
      copyLabel.textContent = "select + copy";
    }
    setTimeout(() => {
      copyLabel.textContent = "copy";
      swap(copyLabel);
    }, 1600);
  };
  copyButton?.addEventListener("click", copyInstall);

  const sections = [...document.querySelectorAll<HTMLElement>("[data-section]")];
  mountStatus({
    sections,
    links: [...document.querySelectorAll<HTMLAnchorElement>("[data-section-link]")],
    where: document.querySelector("[data-status-section]"),
    pos: document.querySelector("[data-status-pos]"),
  });

  const keymap: Record<string, () => void> = {
    i: copyInstall,
    p: () => document.querySelector<HTMLButtonElement>("[data-tui-toggle]")?.click(),
    d: () => (location.href = "/docs/"),
  };
  sections.forEach((section, i) => (keymap[String(i + 1)] = () => jumpTo(section)));
  mountKeys(keymap);
</script>
