---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getGuide, guides } from "../../data/guides";

const guide = getGuide("docs");
---

<DocsLayout guide={guide}>
  <section class="docs-hero docs-searchable" id="overview" data-search="documentation overview install sample report">
    <h1>Get started with Repyy</h1>
    <p>Scan an unfamiliar checkout and review the findings before you install dependencies or run the project.</p>
    <div class="docs-overview-actions">
      <a class="docs-install-link" href="/installation/">Install Repyy</a>
      <a href="/demo/sample/sample.html">Open a sample report</a>
    </div>
  </section>

  <section class="docs-section docs-searchable" id="getting-started" data-search="getting started first scan local folder terminal tui interactive">
    <h2>Run your first scan</h2>
    <p>Replace <code>./repository</code> with the path to your checkout.</p>
    <div class="docs-command">
      <div><span>Scan and review in your terminal</span><button type="button" data-copy="repyy scan ./repository --format tui">Copy</button></div>
      <code>repyy scan ./repository --format tui</code>
    </div>
    <p>Press <kbd>Enter</kbd> to open a finding or <kbd>e</kbd> to export the report. Check coverage before relying on the result.</p>
    <figure class="docs-overview-preview">
      <a class="docs-overview-image" href="/images/terminal-review.png" aria-label="Open the full-size terminal screenshot">
        <img
          src="/images/terminal-review.png"
          alt="Repyy's terminal review showing scan coverage, a findings queue, and the recommended action for the selected finding."
          width="1532"
          height="846"
        />
      </a>
      <figcaption><a href="/cli/#interactive-review">Interactive review controls</a></figcaption>
    </figure>
  </section>

  <section class="docs-section docs-searchable" id="choose-your-path" data-search="common tasks reference guides">
    <h2>Next steps</h2>
    <ul class="docs-reference-links">
      <li id="verdicts-docs"><a href="/trust/#incomplete-scans-and-exit-codes">Understand scan statuses</a></li>
      <li id="reports-docs"><a href="/cli/#reports">Compare report formats</a></li>
      <li><a href="/cli/#scan-flags">Look up CLI flags</a></li>
      <li id="recipes"><a href="/cli/#recipes">Copy scan examples</a></li>
      <li><a href="/isolation/#docker">Scan with Docker</a></li>
      <li><a href="/verification/">Verify a download</a></li>
      <li id="limits-docs"><a href="/coverage/#limits">Check scan limits</a></li>
      <li id="privacy"><a href="/trust/#local-data-handling">Check how scan data is handled</a></li>
      <li id="intelligence"><a href="/intelligence/#status">Check the intelligence snapshot</a></li>
      <li id="agent-skill-docs"><a href="/agent-skill/#install">Install the Repyy agent skill</a></li>
    </ul>
    <details class="docs-overview-guides docs-section-menu">
      <summary>All guides</summary>
      <div class="docs-toc-links">
        {guides
          .filter((item) => item.slug !== "docs")
          .map((item) => <a href={item.route}>{item.label}</a>)}
      </div>
    </details>
  </section>
</DocsLayout>

<style>
  .docs-overview-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-block-start: 1.25rem;
  }

  .docs-overview-actions a,
  .docs-overview-preview a,
  .docs-reference-links a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: #a1381c;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .docs-overview-actions .docs-install-link {
    padding-inline: 1rem;
    border-radius: var(--radius-control);
    background: var(--ink);
    color: white;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .docs-install-link:hover {
    opacity: 0.85;
  }

  .docs-overview-preview {
    margin: 1.25rem 0 0;
  }

  .docs-overview-preview .docs-overview-image {
    display: block;
    border-radius: var(--radius-control);
  }

  .docs-overview-preview img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-control);
  }

  .docs-reference-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem 1rem;
    padding-inline-start: 0;
    list-style: none;
  }

  .docs-overview-guides {
    display: none;
  }

  @media (max-width: 760px) {
    .docs-overview-guides {
      display: block;
    }
  }
</style>
