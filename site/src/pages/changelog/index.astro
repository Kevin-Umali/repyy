---
import { createSatteriMarkdownProcessor } from "@astrojs/markdown-satteri";
import changelog from "../../../../CHANGELOG.md?raw";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getGuide } from "../../data/guides";

const headings = [...changelog.matchAll(/^## \[([^\]]+)\](?: - ([^\r\n]+))?\s*$/gm)];
const renderer = await createSatteriMarkdownProcessor();
const releases = await Promise.all(headings.map(async (heading, index) => {
  const body = changelog.slice(heading.index! + heading[0].length, headings[index + 1]?.index).trim();
  const version = heading[1];
  const id = version === "Unreleased" ? "unreleased" : `version-${version.replaceAll(".", "-")}`;
  const rendered = await renderer.render(body);
  return {
    id,
    label: version === "Unreleased" ? version : `Version ${version}`,
    title: heading[2] ? `${version} · ${heading[2]}` : version,
    body,
    html: rendered.code.replace(/(<h[3-6]) id="[^"]*"/g, "$1"),
  };
}));
const entries = releases.filter((release) => release.body);
const guide = {
  ...getGuide("changelog"),
  sections: [{ id: "overview", label: "Release changes" }, ...entries.map(({ id, label }) => ({ id, label }))],
};
---

<DocsLayout guide={guide}>
  <section class="docs-hero docs-searchable" id="overview">
    <p class="docs-kicker">Release changes</p>
    <h1>What changed.<span>And where to verify it.</span></h1>
    <p>
      Release notes come from the repository <a href="https://github.com/Kevin-Umali/repyy/blob/main/CHANGELOG.md">CHANGELOG.md</a>.
      Use the <a href="/verification/">verification guide</a> for signed release artifacts.
    </p>
  </section>

  {entries.map((entry) => (
    <section class="docs-section docs-searchable changelog-entry" id={entry.id}>
      <h2>{entry.title}</h2>
      <div set:html={entry.html} />
    </section>
  ))}
</DocsLayout>

<style>
  .changelog-entry :global(li a),
  .changelog-entry :global(p a) {
    color: #a1381c;
    text-decoration: underline;
    text-decoration-color: #cda99b;
    text-underline-offset: 0.18em;
  }
  .changelog-entry :global(code) {
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    background: #ececef;
    color: #55555a;
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }
  .changelog-entry :global(p) {
    color: var(--muted);
    line-height: 1.75;
  }
</style>
