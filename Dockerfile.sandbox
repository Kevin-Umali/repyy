FROM --platform=$BUILDPLATFORM \
    golang:1.26.10-alpine@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308 AS builder

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
ARG BUILT_BY=development

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
    -ldflags="-s -w \
      -X main.version=${VERSION} \
      -X github.com/Kevin-Umali/repyy/internal/buildinfo.Commit=${COMMIT} \
      -X github.com/Kevin-Umali/repyy/internal/buildinfo.Date=${BUILD_DATE} \
      -X 'github.com/Kevin-Umali/repyy/internal/buildinfo.BuiltBy=${BUILT_BY}'" \
    -o /repyy ./cmd/repyy

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
RUN apk add --no-cache ca-certificates git \
    && addgroup -S -g 65532 repyy \
    && adduser -S -D -H -u 65532 -G repyy repyy \
    && mkdir -p /input /work /config \
    && touch /config/rules.yaml
COPY --from=builder /repyy /usr/local/bin/repyy
ENV HOME=/tmp
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/repyy"]
